index 000000000..f0b9eccb9
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4-v1.3.dts
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Xunlong Orange Pi CM4 v1.3.
+ *
+ * Ethernet PHY I/O is 3.3V with reset on GPIO3_C2, matching the Orange
+ * Pi 3B v1.1 split. Covers silkscreen v1.3 / v1.3.1 (pre-v1.4).
+ */
+
+/dts-v1/;
+
+#include "rk3566-orangepi-cm4.dtsi"
+
+/ {
+	model = "Xunlong Orange Pi CM4 v1.3";
+	compatible = "xunlong,orangepi-cm4-v1.3", "xunlong,orangepi-cm4", "rockchip,rk3566";
+};
+
+&pmu_io_domains {
+	vccio5-supply = <&vcc_3v3>;
+};
+
+&gmac1 {
+	phy-handle = <&rgmii_phy1>;
+	status = "okay";
+};
+
+&mdio1 {
+	rgmii_phy1: ethernet-phy@0 {
+		compatible = "ethernet-phy-ieee802.3-c22";
+		reg = <0>;
+		reset-assert-us = <20000>;
+		reset-deassert-us = <50000>;
+		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
+	};
+};
+
+/*
+ * i2c2 is on 40-pin 3/5 (i2c2_sda_m1 / i2c2_scl_m1).
+ */
+&i2c2 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c2m1_xfer>;
+	status = "disabled";
+};
+
+/*
+ * i2c3 is on 40-pin 27/28 (i2c3_sda_m0 / i2c3_scl_m0).
+ * Exclusive with uart3 m0.
+ */
+&i2c3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c3m0_xfer>;
+	status = "disabled";
+};
+
+/*
+ * i2c4 is on 40-pin 19/23 (i2c4_sda_m0 / i2c4_scl_m0).
+ * Exclusive with spi3 m0.
+ */
+&i2c4 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&i2c4m0_xfer>;
+	status = "disabled";
+};
+
+/*
+ * uart3 is on 40-pin 27/28 (uart3_tx_m0 / uart3_rx_m0).
+ * Exclusive with i2c3 m0.
+ */
+&uart3 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart3m0_xfer>;
+	status = "disabled";
+};
+
+/*
+ * uart7 is on 40-pin 16/15 (uart7_tx_m2 / uart7_rx_m2).
+ */
+&uart7 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart7m2_xfer>;
+	status = "disabled";
+};
+
+/*
+ * uart9 is on 40-pin 22/29 (uart9_tx_m2 / uart9_rx_m2).
+ */
+&uart9 {
+	pinctrl-names = "default";
+	pinctrl-0 = <&uart9m2_xfer>;
+	status = "disabled";
+};
