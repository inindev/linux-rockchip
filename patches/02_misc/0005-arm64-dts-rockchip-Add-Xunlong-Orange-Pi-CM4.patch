diff --git a/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4.dtsi b/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4.dtsi
new file mode 100644
index 000000000..0db41c3b3
--- /dev/null
+++ b/arch/arm64/boot/dts/rockchip/rk3566-orangepi-cm4.dtsi
@@ -0,0 +1,724 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Device tree for the Xunlong Orange Pi CM4 (RK3566).
+ *
+ * Ported from the vendor tree (linux-orangepi, orange-pi-5.10-rk35xx)
+ * using the mainline Orange Pi 3B DT as the template. The CM4 with the
+ * official IO board is electrically close to the 3B (RK809, SYR827,
+ * AP6256, same WiFi/BT/PCIe-reset GPIOs). It is not a SOQuartz clone:
+ * SOQuartz uses a TCS4525 CPU regulator and different WiFi/PCIe pins.
+ *
+ * Optional cameras, DSI, and eDP from the vendor DT are left out;
+ * those nodes were disabled there as well.
+ */
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/pinctrl/rockchip.h>
+#include <dt-bindings/soc/rockchip,vop2.h>
+#include "rk3566.dtsi"
+
+/ {
+	model = "Xunlong Orange Pi CM4";
+	compatible = "xunlong,orangepi-cm4", "rockchip,rk3566";
+
+	aliases {
+		ethernet0 = &gmac1;
+		mmc0 = &sdhci;
+		mmc1 = &sdmmc0;
+		mmc2 = &sdmmc1;
+	};
+
+	chosen {
+		stdout-path = "serial2:1500000n8";
+	};
+
+	hdmi-con {
+		compatible = "hdmi-connector";
+		type = "a";
+
+		port {
+			hdmi_con_in: endpoint {
+				remote-endpoint = <&hdmi_out_con>;
+			};
+		};
+	};
+
+	leds {
+		compatible = "gpio-leds";
+		pinctrl-names = "default";
+		pinctrl-0 = <&work_led>;
+
+		led-0 {
+			color = <LED_COLOR_ID_GREEN>;
+			default-state = "on";
+			function = LED_FUNCTION_HEARTBEAT;
+			gpios = <&gpio0 RK_PC0 GPIO_ACTIVE_HIGH>;
+			linux,default-trigger = "heartbeat";
+		};
+	};
+
+	fan: pwm-fan {
+		compatible = "pwm-fan";
+		#cooling-cells = <2>;
+		cooling-levels = <0 50 100 150 200 255>;
+		pwms = <&pwm7 0 50000 0>;
+	};
+
+	/* Always-on on the official IO board; no GPIO enable unlike 3B. */
+	vcc3v3_pcie: regulator-3v3-vcc-pcie {
+		compatible = "regulator-fixed";
+		regulator-name = "vcc3v3_pcie";
+		regulator-always-on;
+		regulator-boot-on;
+		regulator-min-microvolt = <3300000>;
+		regulator-max-microvolt = <3300000>;
+		vin-supply = <&vcc3v3_sys>;
+	};
+
+	vcc3v3_sys: regulator-3v3-vcc-sys {
+		compatible = "regulator-fixed";
